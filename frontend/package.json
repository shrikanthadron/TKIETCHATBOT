    "groq-sdk": "^0.21.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "next": "15.5.18",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "recharts": "^2.15.3",
    "serverless-http": "^3.2.0",
    "zod": "^3.25.28"
