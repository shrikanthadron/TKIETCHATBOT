# --- Neon (Vercel production) ---
# DATABASE_URL = pooled connection string from Neon dashboard
# DIRECT_URL     = direct (non-pooler) connection string from Neon dashboard

# --- Local PostgreSQL ---
DATABASE_URL="postgresql://learniq:learniq_secret@localhost:5432/learniq"
DIRECT_URL="postgresql://learniq:learniq_secret@localhost:5432/learniq"

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
GROQ_API_KEY="your_groq_api_key_here"
PORT=4000
FRONTEND_URL="http://localhost:3000"
