# Local dev with separate Express backend (port 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Vercel production — use same-origin API (set in Vercel dashboard):
# NEXT_PUBLIC_API_URL=/api

# Required when running API through Next.js (frontend npm run dev) or on Vercel:
# DATABASE_URL=
# DIRECT_URL=
# JWT_SECRET=
# GROQ_API_KEY=
# FRONTEND_URL=https://your-app.vercel.app
